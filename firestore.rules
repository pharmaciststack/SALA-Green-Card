rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuth() { return request.auth != null; }
    function myUid() { return request.auth.uid; }
    function getUser() { return get(/databases/$(database)/documents/users/$(myUid())).data; }
    function hasRole(role) { return getUser().role == role; }
    function isAdmin() { return hasRole('admin'); }

    // Users collection
    match /users/{uid} {
      allow read: if isAuth() && (myUid() == uid || isAdmin());
      allow write: if isAuth() && (myUid() == uid || isAdmin());
    }

    // Leave quotas
    match /leave_quotas/{docId} {
      allow read: if isAuth() && (docId.matches(myUid() + '_.*') || isAdmin());
      allow write: if isAuth() && isAdmin();
    }

    // Attendance stats
    match /attendance_stats/{docId} {
      allow read: if isAuth() && (docId.matches(myUid() + '_.*') || isAdmin() || hasRole('pharmacist') || hasRole('area_manager') || hasRole('director'));
      allow write: if isAuth() && (docId.matches(myUid() + '_.*') || isAdmin());
    }

    // Requests
    match /requests/{requestId} {
      allow read: if isAuth() && (
        resource.data.submittedBy == myUid() ||
        isAdmin() ||
        hasRole('pharmacist') ||
        hasRole('area_manager') ||
        hasRole('director')
      );
      allow create: if isAuth() && request.resource.data.submittedBy == myUid();
      allow update: if isAuth() && (
        isAdmin() ||
        (hasRole('pharmacist') && resource.data.status == 'pending_pharmacist') ||
        (hasRole('area_manager') && resource.data.status == 'pending_manager') ||
        (hasRole('director') && resource.data.status == 'pending_director')
      );
    }
  }
}
